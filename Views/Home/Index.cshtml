
@{
    ViewData["Title"] = "Home Page";
}

<h1>Complejo Fausto</h1>
<img src="/imagenes/ComplejoFoto.jpg" alt="Foto complejo"/>
@foreach(KeyValuePair<int, Cabaña> kvp in ViewBag.Complejo.DevolverCabañas())
{
    Cabaña cabaña = kvp.Value;
    <p>@cabaña.GetNombre()</p>
    <img src= "@cabaña.GetFoto()" alt="Foto cabaña"/>
    <p>Capacidad: @cabaña.GetCapacidad()</p>
    int id = cabaña.GetId();
    @Html.ActionLink(linkText: $"{cabaña.GetNombre()}", actionName: "SelectIntegrante", controllerName: "Home", routeValues: new {id = id})
}
